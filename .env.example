# Copy to .env and fill from your Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — Work / Office-work tab, Google Calendar sync.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Add your app origin to "Authorised JavaScript origins". Enable the Calendar API.
# Scope used (read-only): https://www.googleapis.com/auth/calendar.events.readonly
VITE_GOOGLE_CLIENT_ID=
